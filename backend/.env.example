DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nkash_hr"
PORT=3011
CLIENT_URL=http://localhost:3010
# Public base URL of this API: used for OAuth callbacks and calendar push notifications
API_URL=http://localhost:3011
# 64+ random hex chars
JWT_SECRET=change-me
# 32 bytes as 64 hex chars: AES-256 key for ID numbers, bank details and calendar tokens. Losing it makes them unreadable.
MASTER_KEY=

# Brevo transactional email. Without BREVO_API_KEY, emails print to this console (development only).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@nkashheaven.co.za
BREVO_SENDER_NAME=NkashHeaven-HR
# Shared secret in the Brevo webhook URL: /api/webhooks/brevo/<secret>
BREVO_WEBHOOK_SECRET=

# Calendar sync. These can also be set by the Super Admin under Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Personal token for importing from ClickUp. Can also be saved from the Projects import screen.
CLICKUP_API_TOKEN=
# Cloud storage for photos, logos and documents (any S3-compatible bucket). Without AWS_BUCKET, files stay in backend/uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=
# Folder inside the bucket
STORAGE_PREFIX=nkash-hr
# Outside production, only these comma-separated addresses get real email; the rest print to this console.
EMAIL_TEST_ALLOW=
# Set to false to skip background jobs (auto check-out, accrual, sync, email queue)
RUN_JOBS=true
