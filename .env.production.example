# The MySQL password here must match MYSQL_ROOT_PASSWORD in your shell.
DATABASE_URL=mysql://root:CHANGE_ME@mysql:3306/nkash_hr
CLIENT_URL=https://hr.example.com
API_URL=https://hr.example.com
# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32. Losing it makes ID numbers and bank details unreadable.
MASTER_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=NkashHeaven-HR
BREVO_WEBHOOK_SECRET=
# Photos, logos and documents. Without AWS_BUCKET they stay on the uploads volume.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=
STORAGE_PREFIX=nkash-hr
RUN_JOBS=true
